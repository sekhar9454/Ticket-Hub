<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ticket Hub</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="min-h-screen bg-gradient-to-br from-indigo-900 via-purple-900 to-pink-800 flex flex-col">
    <!-- Profile Side Panel -->
    <div id="profile-panel" class="fixed top-0 right-0 h-full w-80 bg-white bg-opacity-10 backdrop-blur-lg border-l border-white border-opacity-20 transform translate-x-full transition-transform duration-300 ease-in-out z-50">
        <div class="p-6">
            <button id="close-profile-btn" class="absolute top-4 right-4 text-white hover:text-gray-300">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                </svg>
            </button>
            <h2 class="text-2xl font-bold text-white mb-6">Profile</h2>
            <div class="space-y-4 text-white">
                <div>
                    <label class="block text-sm font-medium">Name</label>
                    <p class="mt-1 px-4 py-2 bg-white bg-opacity-20 rounded-lg"><%= name %></p>
                </div>
                <div>
                    <label class="block text-sm font-medium">Email</label>
                    <p class="mt-1 px-4 py-2 bg-white bg-opacity-20 rounded-lg"><%= email %></p>
                </div>
                <button class="w-full py-2 bg-gradient-to-r from-pink-500 to-purple-600 text-white font-semibold rounded-lg shadow-lg hover:from-pink-600 hover:to-purple-700 transition duration-300 transform hover:scale-105" >
                    Edit Profile
                </button>
                <button class="w-full py-2 bg-gradient-to-r from-red-500 to-red-600 text-white font-semibold rounded-lg shadow-lg hover:from-red-600 hover:to-red-700 transition duration-300 transform hover:scale-105">
                    Logout
                </button>
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <div class="flex-1 flex flex-col items-center p-6">
        <!-- Title -->
        <h1 class="text-4xl font-extrabold text-white text-center mb-8">Ticket Hub</h1>

        <!-- Profile Toggle Button -->
        <button id="open-profile-btn" class="fixed top-4 right-4 text-white hover:text-gray-300">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5.121 17.804A4.992 4.992 0 0112 15a4.992 4.992 0 016.879 2.804M15 10a3 3 0 11-6 0 3 3 0 016 0z"></path>
            </svg>
        </button>

        <!-- Search Bar -->
        <div class="w-full max-w-lg mb-12">
            <div class="relative">
                <input type="text" id="search" name="search" placeholder="Search for train, movie, or concert tickets..."
                       class="w-full px-4 py-3 bg-white bg-opacity-20 border border-white border-opacity-30 rounded-lg text-white placeholder-gray-300 focus:outline-none focus:ring-2 focus:ring-pink-500 transition duration-300">
                <button class="absolute right-2 top-1/2 transform -translate-y-1/2 bg-gradient-to-r from-pink-500 to-purple-600 text-white px-4 py-1 rounded-lg hover:from-pink-600 hover:to-purple-700 transition duration-300">
                    Search
                </button>
            </div>
        </div>

        <!-- Ticket Categories -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 w-full max-w-5xl">
            <!-- Movie Ticket Thumbnail -->
            <div class="bg-white bg-opacity-10 backdrop-blur-lg rounded-2xl p-6 shadow-xl border border-white border-opacity-20 text-center">
                <img src="https://via.placeholder.com/300x200?text=Movie+Poster" alt="Movie Ticket" class="w-full h-48 object-cover rounded-lg mb-4">
                <h3 class="text-xl font-semibold text-white">Movie Tickets</h3>
                <p class="text-gray-300 text-sm mt-2">Book tickets for the latest blockbusters and enjoy a cinematic experience.</p>
                <button class="mt-4 py-2 px-4 bg-gradient-to-r from-pink-500 to-purple-600 text-white font-semibold rounded-lg shadow-lg hover:from-pink-600 hover:to-purple-700 transition duration-300 transform hover:scale-105">
                    Book Now
                </button>
            </div>

            <!-- Concert Ticket Thumbnail -->
            <div class="bg-white bg-opacity-10 backdrop-blur-lg rounded-2xl p-6 shadow-xl border border-white border-opacity-20 text-center">
                <img src="https://via.placeholder.com/300x200?text=Concert+Poster" alt="Concert Ticket" class="w-full h-48 object-cover rounded-lg mb-4">
                <h3 class="text-xl font-semibold text-white">Concert Tickets</h3>
                <p class="text-gray-300 text-sm mt-2">Experience live music from your favorite artists and bands.</p>
                <button class="mt-4 py-2 px-4 bg-gradient-to-r from-pink-500 to-purple-600 text-white font-semibold rounded-lg shadow-lg hover:from-pink-600 hover:to-purple-700 transition duration-300 transform hover:scale-105">
                    Book Now
                </button>
            </div>

            <!-- Train Ticket Thumbnail -->
            <div class="bg-white bg-opacity-10 backdrop-blur-lg rounded-2xl p-6 shadow-xl border border-white border-opacity-20 text-center">
                <img src="https://via.placeholder.com/300x200?text=Train+Image" alt="Train Ticket" class="w-full h-48 object-cover rounded-lg mb-4">
                <h3 class="text-xl font-semibold text-white">Train Tickets</h3>
                <p class="text-gray-300 text-sm mt-2">Travel comfortably with easy train ticket bookings.</p>
                <button class="mt-4 py-2 px-4 bg-gradient-to-r from-pink-500 to-purple-600 text-white font-semibold rounded-lg shadow-lg hover:from-pink-600 hover:to-purple-700 transition duration-300 transform hover:scale-105">
                    Book Now
                </button>
            </div>
        </div>
    </div>

    <!-- JavaScript for Profile Panel Toggle -->
    <script>
        const profilePanel = document.getElementById('profile-panel');
        const openProfileBtn = document.getElementById('open-profile-btn');
        const closeProfileBtn = document.getElementById('close-profile-btn');

        openProfileBtn.addEventListener('click', () => {
            profilePanel.classList.remove('translate-x-full');
        });

        closeProfileBtn.addEventListener('click', () => {
            profilePanel.classList.add('translate-x-full');

        });
      
    </script>
    <script src="../routes/auth.js"></script>
    <script src="../middleware/authMiddleware.js"></script>
</body>
</html>